{
  "name": "the-note",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.2.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/livesource.test.mjs && node tests/format.test.mjs && node tests/tabs.test.mjs && node tests/autosave-tabs.test.mjs && node tests/accessibility.test.mjs && node tests/markdown-regressions.test.mjs && node tests/compatibility.test.mjs && node tests/editor-interactions.test.mjs && node tests/execution.test.mjs && node tests/ai.test.mjs && node tests/diff.test.mjs && node tests/tableformula.test.mjs && node tests/imagepaste.test.mjs",
    "test:e2e": "node tests/e2e-seltoolbar.mjs && node tests/e2e-tablerails.mjs && node tests/e2e-slashmenu.mjs && node tests/e2e-imageprops.mjs && node tests/e2e-sidebar.mjs && node tests/e2e-theme.mjs && node tests/e2e-settings.mjs && node tests/e2e-chrome.mjs && node tests/e2e-links.mjs && node tests/e2e-lists.mjs && node tests/e2e-tabs.mjs && node tests/e2e-mermaid.mjs && node tests/e2e-reveal.mjs",
    "test:perf": "node tests/perf-render.mjs --assert",
    "lint": "eslint src",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "tauri": "tauri",
    "audit:markdown": "node scripts/audit-markdown.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test:execution": "node tests/execution.test.mjs",
    "test:notebook": "node tests/e2e-notebook.mjs",
    "package:macos": "bash scripts/package-macos.sh",
    "test:ai": "node tests/ai.test.mjs",
    "test:ai:ui": "node tests/e2e-ai.mjs",
    "test:diff:ui": "node tests/e2e-diff.mjs",
    "test:workspace:ui": "node tests/e2e-workspace.mjs",
    "test:paste:ui": "node tests/e2e-imagepaste.mjs",
    "test:gallery:ui": "node tests/e2e-gallery.mjs && node tests/e2e-gallerydrag.mjs",
    "build:site": "node scripts/sync-distribution.mjs --check && node scripts/build-site.mjs",
    "build:webapp": "node scripts/build-web-app.mjs",
    "test:webapp": "npm run build:site && npm run build:webapp && node tests/webapp.test.mjs",
    "test:site": "npm run build:site && node tests/site.test.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "2.6.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@terrastruct/d2": "^0.1.33",
    "dompurify": "^3.4.16",
    "js-yaml": "^5.4.2",
    "katex": "^0.18.9",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "shiki": "^4.4.3",
    "solid-js": "^1.9.15",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/katex": "^0.16.8",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-solid": "^0.18.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
